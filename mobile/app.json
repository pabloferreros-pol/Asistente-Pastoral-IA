{
  "expo": {
    "name": "Asistente Pastoral IA",
    "slug": "asistente-pastoral-ia",
    "version": "0.8.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06182A",
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#06182A",
          "barStyle": "light",
          "visibility": "visible",
          "behavior": "inset-swipe",
          "position": "relative"
        }
      ]
    ],
    "android": {
      "package": "ar.org.asistentepastoral.ia"
    },
    "ios": {
      "bundleIdentifier": "ar.org.asistentepastoral.ia",
      "supportsTablet": true
    }
  }
}
